import random

brand_of_car = {
    "BMW": {"fuel": 100, "strength": 100, "consumption": 6},
    "Chevrolet": {"fuel": 200, "strength": 200, "consumption": 7},
    "Volvo": {"fuel": 150, "strength": 150, "consumption": 10},
    "Ferrari": {"fuel": 80, "strength": 80, "consumption": 30}
}

list_of_Job = {
    "Java developer": {"salary": 50, "gladness_less": 10},
    "Python developer": {"salary": 40, "gladness_less": 3},
    "C++ developer": {"salary": 45, "gladness_less": 25},
    "C# developer": {"salary": 100, "gladness_less": 40}
}

list_of_pets = {
    "Dog": {"gladness_boost": 15, "cost": 30},
    "Cat": {"gladness_boost": 10, "cost": 20},
    "Hamster": {"gladness_boost": 5, "cost": 10}
}


class Pet:
    def __init__(self, pet_list):
        self.name = random.choice(list(pet_list))
        self.gladness_boost = pet_list[self.name]["gladness_boost"]
        self.cost = pet_list[self.name]["cost"]


class Auto:
    def __init__(self, brand_list):
        self.brand = random.choice(list(brand_list))
        self.fuel = brand_list[self.brand]["fuel"]
        self.strength = brand_list[self.brand]["strength"]
        self.consumption = brand_list[self.brand]["consumption"]

    def drive(self):
        if self.strength > 0 and self.fuel >= self.consumption:
            self.fuel -= self.consumption
            self.strength -= 1
            return True

        print("The car cannot drive")
        return False


class House:
    def __init__(self):
        self.mess = 0
        self.food = 0


class Job:
    def __init__(self, job_list):
        self.job = random.choice(list(job_list))
        self.salary = job_list[self.job]["salary"]
        self.gladness_less = job_list[self.job]["gladness_less"]


class Human:
    def __init__(self, name="HUMAN", job=None, home=None, car=None, pet=None):
        self.name = name
        self.job = job
        self.home = home
        self.car = car
        self.pet = pet

        self.money = 100
        self.gladness = 50
        self.satiety = 50

    def get_home(self):
        self.home = House()

    def get_job(self):
        if self.car is None:
            self.get_car()

        if not self.car.drive():
            self.to_repair()

            if not self.car.drive():
                print("I can't get to work.")
                return False

        self.job = Job(list_of_Job)
        return True

    def get_car(self):
        self.car = Auto(brand_of_car)

    def get_pet(self):
        if self.money >= 30:
            self.pet = Pet(list_of_pets)
            self.money -= self.pet.cost
            print(f"I bought a pet: {self.pet.name}")
            return True
        else:
            print("Not enough money for a pet.")
            return False

    def play_with_pet(self):
        if self.pet is None:
            if not self.get_pet():
                return
        print(f"Playing with {self.pet.name}!")
        self.gladness += self.pet.gladness_boost
        self.satiety -= 3
        if self.gladness > 100:
            self.gladness = 100

    def eat(self):
        if self.satiety >= 100:
            self.satiety = 100
            return

        if self.home.food < 5:
            self.shopping("Food")

        if self.home.food >= 5:
            self.satiety += 5
            self.home.food -= 5

        if self.satiety > 100:
            self.satiety = 100

    def work(self):
        if self.job is None:
            if not self.get_job():
                return

        if self.car is None:
            self.get_car()

        if not self.car.drive():
            print("I need to repair my car.")
            self.to_repair()

            if not self.car.drive():
                print("I can't go to work.")
                return

        self.money += self.job.salary
        self.gladness -= self.job.gladness_less
        self.satiety -= 4

    def shopping(self, manage):
        if self.car is None:
            self.get_car()

        if not self.car.drive():
            print("I need to repair my car before going shopping.")
            self.to_repair()

            if not self.car.drive():
                print("I can't go shopping.")
                return

        if manage == "Food":
            if self.money >= 50:
                print("Bought food")
                self.money -= 50
                self.home.food += 50
            else:
                print("Not enough money for food.")

        elif manage == "fuel":
            if self.money >= 40:
                print("Bought fuel")
                self.money -= 40
                self.car.fuel += 100
            else:
                print("Not enough money for fuel.")

        elif manage == "delicacies":
            if self.money >= 15:
                print("Delicacies!!!!")
                self.gladness += 10
                self.satiety += 2
                self.money -= 15

                if self.gladness > 100:
                    self.gladness = 100

                if self.satiety > 100:
                    self.satiety = 100
            else:
                print("Not enough money for delicacies.")

    def chill(self):
        self.gladness += 10
        self.home.mess += 5

        if self.gladness > 100:
            self.gladness = 100

    def clean_home(self):
        self.gladness -= 5
        self.home.mess = 0

    def to_repair(self):
        if self.money >= 50:
            print("Repairing the car...")
            self.car.strength += 100
            self.money -= 50
        else:
            print("Not enough money to repair the car.")

    def days_indexes(self, day):
        day_title = f"Today the {day} of {self.name}'s life"
        print(f"{day_title:=^50}")
        print()
        human_indexes = f"{self.name}'s indexes"
        print(f"{human_indexes:=^50}")
        print()
        print(f"Money - {self.money}")
        print(f"Satiety - {self.satiety}")
        print(f"Gladness - {self.gladness}")
        print()
        home_indexes = "Home indexes"
        print(f"{home_indexes:=^50}")
        print()
        print(f"Food - {self.home.food}")
        print(f"Mess - {self.home.mess}")
        print()
        car_indexes = f"{self.car.brand} car indexes"
        print(f"{car_indexes:=^50}")
        print()
        print(f"Fuel - {self.car.fuel}")
        print(f"Strength - {self.car.strength}")
        if self.job:
            print(f"Job - {self.job.job}")
            print(f"Salary - {self.job.salary}")
        if self.pet:
            print(f"Pet - {self.pet.name}")
        print()

    def is_alive(self):
        if self.gladness < 0:
            print("Depression....")
            return False

        if self.satiety < 0:
            print("Dead")
            return False

        if self.money < -500:
            print("Bankrupt...")
            return False

        return True

    def live(self, day):
        if not self.is_alive():
            return False

        if self.home is None:
            print("Settled in the house")
            self.get_home()

        if self.car is None:
            self.get_car()
            print(f"I bought a car {self.car.brand}")

        if self.job is None:
            if self.get_job():
                print(f"I got a job: {self.job.job}")

        self.days_indexes(day)

        dice = random.randint(1, 5)

        if self.satiety < 20:
            print("I'll go eat")
            self.eat()

        elif self.gladness < 20:
            if self.home.mess > 15:
                print(
                    "I want to chill, but there is too much mess...\n"
                    "So I will clean the house"
                )
                self.clean_home()
            else:
                print("Let's chill")
                self.chill()

        elif self.money < 0:
            print("Start working")
            self.work()

        elif self.car.strength < 15:
            print("I need to repair my car")
            self.to_repair()

        elif dice == 1:
            print("Let's chill")
            self.chill()

        elif dice == 2:
            print("Start working")
            self.work()

        elif dice == 3:
            print(
                "I want to chill, but there is too much mess...\n"
                "So I will clean the house"
            )
            self.clean_home()

        elif dice == 4:
            print("Time for treats!")
            self.shopping("delicacies")

        elif dice == 5:
            print("Let's play with pet!")
            self.play_with_pet()

        print()

        return self.is_alive()


nick = Human(name="NICK")

for day in range(1, 8):
    if not nick.live(day):
        break
